# Example GitHub Actions workflow for publishing to PyPI using uv
# Rename this file to publish-pypi.yml to use it
#
# Before using:
# 1. Add your project as a Trusted Publisher on PyPI:
#    https://pypi.org/manage/account/publishing/
# 2. Configure with your repository details:
#    - PyPI project name: fakenews-br-data
#    - Workflow filename: publish-pypi.yml
#    - Environment: release (optional but recommended)

name: Publish to PyPI

on:
  release:
    types: [published]
  # Or manually trigger:
  # workflow_dispatch:

# Use environment for extra protection (optional but recommended)
# Configure at: https://github.com/USERNAME/REPO/settings/environments
# environment:
#   name: release

jobs:
  build-and-publish:
    runs-on: ubuntu-latest
    
    # Required for PyPI Trusted Publishing
    permissions:
      id-token: write
      contents: read
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      
      - name: Install uv
        uses: astral-sh/setup-uv@v1
        with:
          version: "latest"
      
      - name: Build package
        run: |
          # Build without tool.uv.sources (recommended for publishing)
          uv build --no-sources
          
          # Verify build artifacts
          ls -lh dist/
      
      - name: Publish to PyPI
        run: uv publish
        # No token needed! GitHub Actions + Trusted Publisher = automatic auth
      
      - name: Upload build artifacts
        uses: actions/upload-artifact@v4
        with:
          name: dist
          path: dist/
          retention-days: 90

